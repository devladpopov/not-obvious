[4.91,"o","Cliché cloud (20, embedder gemini-embedding-001):\r\n"]
[4.99,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Build and sell niche WordPress or Shopify plugins for small businesses.\r\n"]
[5.07,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Offer freelance website maintenance and security monitoring retainers to local companies.\r\n"]
[5.15,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Create and sell online courses teaching a specific programming language or framework.\r\n"]
[5.23,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Develop custom Chrome extensions or Notion templates and sell them on marketplaces.\r\n"]
[5.31,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Provide automation consulting that connects clients' tools using Zapier, Make, or custom scripts.\r\n"]
[5.39,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Launch a micro-SaaS tool solving one narrow problem for a specific professional niche.\r\n"]
[5.47,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Build no-code app prototypes for startups and non-technical founders on a project basis.\r\n"]
[5.55,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Sell mobile app templates or UI kits on marketplaces like Envato or Gumroad.\r\n"]
[5.63,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Offer technical tutoring or coding bootcamp mentorship for career changers via video sessions.\r\n"]
[5.71,"o","  \u001b[90m[claude-haiku-5-5]\u001b[0m Create and monetize open-source tools with paid hosting, support, or enterprise add-ons.\r\n"]
[5.79,"o","  \u001b[90m[gemini-flash-lite-latest]\u001b[0m Build and sell micro-SaaS products targeting niche markets with recurring subscription models.\r\n"]
[5.87,"o","  \u001b[90m[gemini-flash-lite-latest]\u001b[0m Develop and publish mobile apps or indie games on app stores with in-app purchases.\r\n"]
[5.95,"o","  \u001b[90m[gemini-flash-lite-latest]\u001b[0m Create and sell paid developer tools, CLI utilities, or browser extensions to boost productivity.\r\n"]
