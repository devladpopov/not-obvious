{
  "name": "not-obvious-mcp",
  "version": "0.0.1",
  "description": "See what every AI would say. Then go somewhere else. MCP server that maps the cliché cloud of typical LLM answers, diverges with SCAMPER/TRIZ/far analogies, and measures originality with a Cliché Score.",
  "license": "MIT",
  "type": "module",
  "author": "Vlad Popov",
  "homepage": "https://github.com/devladpopov/not-obvious#readme",
  "repository": { "type": "git", "url": "git+https://github.com/devladpopov/not-obvious.git" },
  "bin": {
    "not-obvious-mcp": "./dist/server.js",
    "not-obvious": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "dev": "bun run src/server.ts",
    "cli": "bun run src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": { "node": ">=20" },
  "keywords": ["mcp", "model-context-protocol", "creativity", "brainstorming", "originality", "cliche", "scamper", "triz", "llm", "embeddings"]
}
